msgstr ""
"{{paragraph}}{{random_table:131}}: \"Ges{{phrase:7}}rn wurde in unserer "
"Schule der g{{phrase:6}}ze Sportun{{phrase:7}}rricht abgeblasen wegen "
"Smogalarm. Sagt wohl alles!\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 510"
msgstr ""
"{{paragraph}}{{random_table:131}}: \" Als Sie mich {{phrase:5}} einem Jahr "
"frag{{phrase:7}}n, habe ich gesagt: es könn{{phrase:7}} schlimmer sein. Ich "
"habe recht behal{{phrase:7}}n.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 511"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Sehen Sie doch mal zum "
"Fens{{phrase:7}}r hinaus, wie leuch{{phrase:7}}nd grün die Berge sind, und "
"darüber der azurblaue Himmel -- {{phrase:1}} einzige, was stört, ist dieser "
"graubraune Film dazwischen.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 512"
msgstr "{{random_table:93}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 513"
msgstr "{{random_table:95}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 514"
msgstr "{{random_table:96}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 515"
msgstr "{{random_table:97}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 516"
msgstr "{{random_table:98}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 517"
msgstr "{{random_table:99}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 518"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Letz{{phrase:7}} Woche wurde meine "
"Wohnung ausgeraubt. Die Polizei brauch{{phrase:7}} zwei geschlagene Stunden,"
" bis sie endlich kam!\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 519"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Nu ja, als ich aus dem K{{phrase:6}}st "
"raus war, habe ich keinen Mist mehr gebaut.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 520"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Nein, aber meiner Schwes{{phrase:7}}r "
"wurde {{phrase:5}} einiger Zeit ihr Auto geklaut. {{random_number:10}} "
"Mona{{phrase:7}} spä{{phrase:7}}r wurde es wieder gefunden -- total "
"ausgeschlach{{phrase:7}}t.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 521"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Allerdings. Letz{{phrase:7}}s "
"Wochenende wurde mir meine H{{phrase:6}}dtasche im Einaufszentrum vom Arm "
"gerissen. Ich habe es sofort gemeldet, aber die Polizei kam gar nicht "
"erst.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 522"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Vor einer Woche "
"beobach{{phrase:7}}{{phrase:7}} ich auf dem Weg zur Arbeit, wie "
"jem{{phrase:6}}d Unfallflucht beging. Meinen Sie sowas?\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 523"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Ges{{phrase:7}}rn nacht auf dem Heimweg"
" von der Arbeit drück{{phrase:7}} mir plötzlich ein M{{phrase:6}}n eine "
"Pistole zwischen die Rippen und verl{{phrase:6}}g{{phrase:7}} meinen "
"Geldbeu{{phrase:7}}l und meine Armb{{phrase:6}}duhr. Ich suche mir jetzt "
"eine {{phrase:6}}dere Arbeitss{{phrase:7}}lle-- der Weg ist bei Dunkelheit "
"einfach zu gefährlich.\" "

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 524"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Aus unserer Garage sind neulich "
"sämtliche Werkzeuge gestohlen worden. Und dabei waren wir sogar zuhause! "
"Diese Dreistheit ist schon unglaublich. Die Kriminellen wissen eben, daß sie"
" nichts riskieren -- bei der Polizei muß m{{phrase:6}} sowieso erst zehnmal "
"{{phrase:6}}klingeln, be{{phrase:5}} jem{{phrase:6}}d {{phrase:1}} Telefon "
"abhebt.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 525"
msgstr ""
"{{paragraph}}{{random_table:176}}: \"In unserer Straße gab es "
"letz{{phrase:7}} Woche eine Schießerei. Zum Glück wurde niem{{phrase:6}}d "
"verletzt, aber es hat uns allen einen Schrecken eingejagt.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 526"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Nein, aber es kommt mir so "
"{{phrase:5}}, als gebe es viel mehr zwielichtige Gestal{{phrase:7}}n auf "
"unseren Straßen als früher. Ich fühle mich einfach nicht mehr sicher.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 527"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Ich nicht, aber alle meine Nachbarn. "
"Wir versuchen uns durch gegenseitiges Aufpassen zu schützen. Ich "
"wünsch{{phrase:7}} nur, die Polizei tä{{phrase:7}} {{phrase:1}} ihre.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 528"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Ges{{phrase:7}}rn abend, als ich "
"{{phrase:3}} ein paar Freunden aus dem Kino kam, hatten zwei unserer Autos "
"eingeschlagene Fens{{phrase:7}}rscheiben. So ein Autofens{{phrase:7}}r "
"kos{{phrase:7}}t heu{{phrase:7}} glatt 200 Mark!\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 529"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Du Idiot! Hoch die Patschpfötchen! "
"Sooodele, da sind ja die Mon{{phrase:2}}n...heda! Keine Fotos!!\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 530"
msgstr "{{random_table:93}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 531"
msgstr "{{random_table:94}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 532"
msgstr "{{random_table:96}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 533"
msgstr "{{random_table:97}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 534"
msgstr "{{random_table:98}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 535"
msgstr "{{random_table:99}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 536"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Meiner Meinung nach sind "
"Vermögenss{{phrase:7}}uern pri{{phrase:3}}iv, repressiv und rückständig. Nur"
" barbarische Völker bes{{phrase:7}}uern die Reichen.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 537"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Also so eine blöde Frage aber auch! "
"Kennen Sie etwa jem{{phrase:6}}d, der gerne S{{phrase:7}}uern bezahlt?\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 538"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Also ich vers{{phrase:7}}he durchaus, "
"daß S{{phrase:7}}uern eine wichtige Rolle im öffentlichen Leben spielen, "
"z.B. um unsere städtische Umgebung zu gestal{{phrase:7}}n. Aber ich bin mir "
"nicht sicher, daß unsere S{{phrase:7}}uergelder auch vernünftig verwendet "
"werden.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 539"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Ja, ich finde, wir werden zu hoch "
"bes{{phrase:7}}uert und erhal{{phrase:7}}n keine {{phrase:6}}gemessene "
"Gegenleistung. Irgendwie kommen wir bei der Sache zu kurz.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 540"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Ich finde, wenn die Leu{{phrase:7}} "
"genau {{phrase:3}}verfolgen könn{{phrase:7}}n, wofür ihre S{{phrase:7}}uern "
"verwendet werden, würden sie sich nicht so dagegen sträuben, "
"S{{phrase:7}}uern zu bezahlen. Aber mir ist wirklich nicht klar, wozu ich "
"all {{phrase:1}} Geld hergeben soll.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 541"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Bundess{{phrase:7}}uern, "
"L{{phrase:6}}dess{{phrase:7}}uern, Gemeindes{{phrase:7}}uern -- alles "
"Mist.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 542"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Mich stören sie nicht. Schließlich "
"verd{{phrase:6}}ken wir den S{{phrase:7}}uern, daß wir in einer so "
"freundlichen Stadt leben dürfen.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 543"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Ja, ein bißchen hoch sind sie schon. "
"Mir scheint, die Stadt verschwendet ein bißchen viel für Verwaltung. Das "
"drückt d{{phrase:6}}n schon auf'n Geldbeu{{phrase:7}}l.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 544"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Na klar ärgern mich die "
"S{{phrase:7}}uern! Ich habe {{phrase:1}} Gefühl, die Stadt schiebt mir eine "
"Knarre zwischen die Rippen und sagt: Geld oder Leben!\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 545"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Ich hasse sie. Ich bezahl' sie zwar, "
"aber ich hasse sie.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 546"
msgstr "{{random_table:93}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 547"
msgstr "{{random_table:94}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 548"
msgstr "{{random_table:95}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 549"
msgstr "{{random_table:97}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 550"
msgstr "{{random_table:98}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 551"
msgstr "{{random_table:99}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 552"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Da haben Sie gerade den Richtigen "
"erwischt. Ich wohne schon seit fast zwei Jahren hier in diesem "
"Kühlschr{{phrase:6}}kkarton.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 553"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"{{random_table:175}} auf dem Weg zur "
"Arbeit sah ich eine ziemlich gepflegt und  gebildet aussehende Dame am "
"Straßenr{{phrase:6}}d s{{phrase:7}}hen, so Anf{{phrase:6}}g vierzig, die "
"hielt ein Schild in der H{{phrase:6}}d: \"Arbei{{phrase:7}} für "
"Lebens{{phrase:3}}{{phrase:7}}l\". Als ich acht Stunden spä{{phrase:7}}r "
"wieder heimfuhr, war sie immer noch da.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 554"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Ich kenne eine Frau, die einen "
"Doktorti{{phrase:7}}l hat und für acht Mark die Stunde als "
"Empf{{phrase:6}}gsdame arbei{{phrase:7}}t. Sie sagt, sie ist heilfroh, "
"überhaupt Arbeit zu haben.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 555"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Meine Frau arbei{{phrase:7}}t seit "
"ihrer Entlassung {{phrase:5}} einem Jahr als freie "
"Schrifts{{phrase:7}}llerin, und sie hat jetzt mehr Arbeit als damals. "
"Allerdings, leben k{{phrase:6}}n m{{phrase:6}} davon auch nicht.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 556"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Ich bin {{phrase:5}} 9 "
"Mona{{phrase:7}}n entlassen worden. Meine Frau ist ebenfalls arbeitslos. Mit"
" Hilfe unserer Ersparnisse und unserer mageren "
"Arbeitslosenun{{phrase:7}}rstützung schaffen wir es gerade eben. Die "
"Arbeitslosenhilfe läuft aber in drei Mona{{phrase:7}}n aus, und wir haben "
"noch keine Ahnung, was wir d{{phrase:6}}n machen.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 557"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Ich habe zwei Unidiplome, und wissen "
"Sie, was ich mache? Ich arbei{{phrase:7}} als Kellnerin. Aber "
"wenigs{{phrase:7}}n k{{phrase:6}}n ich so meine Mi{{phrase:2}} bezahlen.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 558"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Es ist einfach extrem schwierig, Arbeit"
" zu finden. Es gibt keine einzige Beschäftigung, die m{{phrase:6}} ohne "
"wei{{phrase:7}}res haben könn{{phrase:7}}. Sogar Putzfrauen gibts noch und "
"nöcher."

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 559"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Um diese Frage zu "
"be{{phrase:6}}two{{phrase:4}}n, brauchen Sie bloß mal tagsüber während der "
"normalen Arbeitszei{{phrase:7}}n durch die Wohngebi{{phrase:2}} fahren. Sie "
"werden eine Menge Leu{{phrase:7}} zuhause finden -- und zwar nicht deshalb, "
"weil denen nichts besseres zu tun einfällt.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 560"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Mein sechsundzw{{phrase:6}}zigjähriger "
"Sohn hat sich für einen neuen Studieng{{phrase:6}}g {{phrase:6}} der Uni "
"eingeschrieben, weil er {{phrase:6}}derthalb Jahre l{{phrase:6}}g vergeblich"
" nach Arbeit gesucht hat. Auf diese Weise nutzt er wenigs{{phrase:7}}ns "
"seine Zeit.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 561"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Unsere Toch{{phrase:7}}r von dreißig "
"Jahren und ihr M{{phrase:6}}n sind gerade bei uns eingezogen, weil sie beide"
" ihre Arbeitss{{phrase:7}}llen verloren haben. In einer derartigen Lage "
"k{{phrase:6}}n m{{phrase:6}} doch die Kinder nicht im Stich lasen!\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 562"
msgstr "{{random_table:93}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 563"
msgstr "{{random_table:94}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 564"
msgstr "{{random_table:95}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 565"
msgstr "{{random_table:96}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 566"
msgstr "{{random_table:98}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 567"
msgstr "{{random_table:99}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 568"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Meine Toch{{phrase:7}}r macht diesen "
"Sommer Mittlere Reife. Sie will, daß ich ihr eine Reise nach New York "
"schenke, da{{phrase:3}} sie den Eiffelturm sehen k{{phrase:6}}n.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 569"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Ich k{{phrase:6}}n mich noch erinnern, "
"wie meine El{{phrase:7}}rn oft außerst{{phrase:6}}de waren, mir {{phrase:3}}"
" den Hausaufgaben zu helfen, weil es für sie zu schwierig war. Aber die "
"Hausaufgaben meiner Toch{{phrase:7}}r sind noch im zehn{{phrase:7}}n "
"Schuljahr so pri{{phrase:3}}iv, daß selbst unser Hund {{phrase:1}} machen "
"könn{{phrase:7}}.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 570"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Ich glaube, wir sind als Bevölkerung "
"insgesamt ziemlich ungebildet.\" "

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 571"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Unser Kinder bekommen die Schultage "
"gekürzt und haben weniger Fächer, da{{phrase:3}} {{phrase:1}} städtische "
"Haushaltsdefizit abgebaut werden k{{phrase:6}}n. Das ist doch ein "
"idiotischer Kompromiß!\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 572"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Daß unsere Schulen miserabel sind, "
"dar{{phrase:6}} bes{{phrase:7}}ht kein Zweifel. Sol{{phrase:6}}ge die "
"Schüler {{phrase:3}} ihren No{{phrase:7}}n Rekorde in der falschen Richtung "
"aufs{{phrase:7}}llen, brauchen wir uns über garnichts zu wundern.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 573"
msgstr ""
"{{paragraph}}{{random_table:131}}: Letz{{phrase:7}} Woche habe ich "
"{{phrase:6}} einer Kreisschulkonferenz {{phrase:7}}ilgenommen, und da ist "
"mir {{phrase:1}} Herz in die Hosen gesunken. Alle Welt witzelt über die "
"Idio{{phrase:7}}n aus {{city}}.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 574"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Das einzige, was mir noch nicht "
"g{{phrase:6}}z klar ist: wer ist wohl dümmer, die Schüler oder der Stadtrat,"
" der die Schulen so hat verkommen lassen.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 575"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Die Schulen befinden sich in einer "
"erbärmlichen Verfassung. Ich habe gerade einen Artikel in der Zeitung "
"gelesen, aus dem her{{phrase:5}}ging, daß unsere Schulen weit "
"un{{phrase:7}}r dem Durchschnitt liegen.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 576"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Es ist besonders peinlich, wenn wir "
"Austauschschüler aus dem Ausl{{phrase:6}}d hierhaben. Wir müssen sie um drei"
" Schuljahre nach oben versetzen, da{{phrase:3}} sie sich nicht "
"l{{phrase:6}}gweilen.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 577"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Unsere Schulen sind einfach "
"un{{phrase:7}}r aller K{{phrase:6}}one. Wenn sie wenigs{{phrase:7}}ns "
"durchschnittlich wären, ginge es ja noch, aber für schlech{{phrase:7}} "
"Schulen gibt es kein Pardon. Wenn sich da nichts ändert, bis mein "
"Zweijähriger eingeschult wird, ziehen wir um.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 578"
msgstr "{{random_table:93}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 579"
msgstr "{{random_table:94}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 580"
msgstr "{{random_table:95}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 581"
msgstr "{{random_table:96}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 582"
msgstr "{{random_table:97}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 583"
msgstr "{{random_table:99}}"

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 584"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Die Klappsmühlen sind knallvoll. Sie "
"ham mich rausgelassen, nnnggAAAAhhh! he, wo gehstndu hin?\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 585"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Gesundheitswesen? Wovon reden Sie "
"eigentlich? Ich sehe in dieser Stadt keine Spur von einem "
"Gesundheitswesen.\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 586"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Was meine Gesundheit "
"{{phrase:6}}bel{{phrase:6}}gt, bin ich im Prinzip auf mich selbst "
"ges{{phrase:7}}llt. Wer sich da auf die Stadt verlassen will, der "
"soll{{phrase:7}} besser nicht kr{{phrase:6}}k werden!\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 587"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Ich denke, die Stadtvä{{phrase:7}}r "
"haben es uns alle laut und deutlich wissen lassen: Unsere Gesundheit ist "
"denen schnurzegal!\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 588"
msgstr ""
"{{paragraph}}{{random_table:132}}: \"Zum Glück werde ich durch den "
"Betriebsarzt versorgt. Aber ich kenne ein Menge Leu{{phrase:7}}, die völlig "
"vom städtischen Gesundheitswesen abhängen, was ihre Gesundheit "
