"nichts!\""

#. German newspaper wording; named markers preserve the original
#. substitutions.
msgctxt "original"
msgid "SC2K newspaper phrase 487"
msgstr ""
"{{paragraph}}{{random_table:131}}: \"Also {{phrase:1}} ist doch {{phrase:1}}"
