msgstr "Hafengebiet"

#. Supplementary OpenSC2K translation; includes multiline tooltips and
#. confirmation messages.
msgid "Airport Zone"
msgstr "Flughafengebiet"

#. Supplementary OpenSC2K translation; includes multiline tooltips and
