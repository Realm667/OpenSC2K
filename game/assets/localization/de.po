#. source.
msgid "Cannot replace the session backup."
msgstr "Die Sitzungssicherung kann nicht ersetzt werden."

#. OpenSC2K multiplayer UI; supplementary translation from English feature
#. source.
msgid "Cannot preserve the previous session."
msgstr "Die vorherige Sitzung kann nicht gesichert werden."

#. OpenSC2K multiplayer UI; supplementary translation from English feature
#. source.
msgid ""
"Cannot install the new session file (%s). The previous save was retained."
msgstr ""
"Die neue Sitzungsdatei kann nicht übernommen werden (%s). Der vorherige "
"Spielstand wurde erhalten."

#. OpenSC2K multiplayer UI; supplementary translation from English feature
#. source.
msgid "The session file is missing or too large."
msgstr "Die Sitzungsdatei fehlt oder ist zu groß."

#. OpenSC2K multiplayer UI; supplementary translation from English feature
#. source.
msgid "Unsupported session file."
msgstr "Nicht unterstützte Sitzungsdatei."

