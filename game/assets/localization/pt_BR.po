msgid "SC2K newspaper phrase 785"
msgstr "Esporte juvenil para as crianças de {{city}}"

#. Supplementary Brazilian Portuguese translation from English; supplied CD
#. newspaper data is English.
msgctxt "original"
msgid "SC2K newspaper phrase 786"
msgstr "Aprovado programa de incentivo à leitura"

#. Supplementary Brazilian Portuguese translation from English; supplied CD
#. newspaper data is English.
msgctxt "original"
msgid "SC2K newspaper phrase 787"
msgstr "Aprovado programa antidrogas"

#. Supplementary Brazilian Portuguese translation from English; supplied CD
#. newspaper data is English.
msgctxt "original"
msgid "SC2K newspaper phrase 788"
msgstr "Treinamento de reanimação para {{random_table:142}} de {{city}}"

#. Supplementary Brazilian Portuguese translation from English; supplied CD
#. newspaper data is English.
msgctxt "original"
msgid "SC2K newspaper phrase 789"
msgstr "Aprovada vigilância de bairro"

#. Supplementary Brazilian Portuguese translation from English; supplied CD
#. newspaper data is English.
msgctxt "original"
msgid "SC2K newspaper phrase 790"
msgstr "Aprovado programa de turismo"

#. Supplementary Brazilian Portuguese translation from English; supplied CD
#. newspaper data is English.
msgctxt "original"
msgid "SC2K newspaper phrase 791"
msgstr "Aprovada campanha publicitária"

#. Supplementary Brazilian Portuguese translation from English; supplied CD
#. newspaper data is English.
msgctxt "original"
msgid "SC2K newspaper phrase 792"
msgstr "Aprovada lei de embelezamento"

#. Supplementary Brazilian Portuguese translation from English; supplied CD
#. newspaper data is English.
msgctxt "original"
msgid "SC2K newspaper phrase 793"
